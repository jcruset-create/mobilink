.tmp.driveupload/

# Flutter (solo se versiona lib/ + pubspec)
*/.dart_tool/
*/.flutter-plugins-dependencies
*/android/
# Excepcion: las apps que compila la CI SI necesitan su carpeta android/ en el
# repositorio (manifiesto, permisos, firma y applicationId). Sin esto, un
# `flutter create --platforms=android` se ignora en silencio y el APK no se
# puede compilar: es lo que le habia pasado a lite_app.
!lite_app/android/
!lite_app/android/**
!taller_app/android/
!taller_app/android/**
*/build/
*/.metadata
*/analysis_options.yaml
lite_app/.gitignore

# Claves de firma de Android. Este repositorio es PÚBLICO: con la clave privada
# cualquiera podría firmar un APK que Android aceptaría como actualización
# legítima de Mobilink. Viven solo en los secrets del repositorio.
*.keystore
*.jks
*.p12
key.properties

# Configuracion de Firebase de las apps: lleva la clave de API del proyecto y
# este repositorio es PUBLICO. La CI la escribe desde un secret.
google-services.json
GoogleService-Info.plist

# Lote de calibración de Therefore: correos REALES y su versión anonimizada.
#
# Este repositorio es PÚBLICO. Un albarán de proveedor lleva sus referencias,
# sus precios de compra y su escala de descuentos: aunque se le quite el nombre,
# publicarlo es publicar las condiciones de compra. Y el correo original lleva
# además direcciones, matrículas y bastidores de clientes.
#
# Los casos se generan en local con scripts/therefore-anonimizar.ts y se quedan
# en local. Lo que sí se versiona son los casos SINTÉTICOS de fixtures/sinteticos,
# que llevan números inventados y sirven para la CI.
server/therefore/fixtures/originales/
server/therefore/fixtures/reales/
