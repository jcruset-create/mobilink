<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="WorkPlanner Taller"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Tema del arranque, visible mientras Flutter inicializa. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Solo los permisos que el código pide hoy:
         · INTERNET  → services/api_service.dart contra /api/taller-operator
         · CAMERA    → image_picker para las fotos del trabajo

         POST_NOTIFICATIONS se declara ya aunque todavía no haya push: pedirlo
         más adelante no obliga a nada y evita tener que tocar el manifiesto
         cuando se añadan los avisos de trabajo asignado (fase 3). Sin él,
         Android 13+ no muestra ninguna notificación. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- La app es para tablets de taller, y muchas no tienen cámara trasera ni
         GPS. Sin esto Play las ocultaría del catálogo. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <queries>
        <!-- Android 11 o superior esconde las apps que no se declaran aqui.
             Sin esto la camara del sistema es INVISIBLE para nosotros:
             image_picker busca quien atiende la peticion, no encuentra a
             nadie y la foto no se hace, sin error y sin abrir nada. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
