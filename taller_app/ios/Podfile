# WorkPlanner Taller — iOS 15.0.
#
# El mínimo NO lo marca aquí ninguna dependencia: el motor de Flutter 3.35.4
# se conforma con 13.0 y los plugins de esta app piden menos todavía
# (image_picker y shared_preferences 12.0, flutter_image_compress 9.0; hive y
# http son Dart puro y no traen pod). Lo marca Apple:
#
#   90068: MinimumOSVersion too low. Starting in Spring 2027, all iOS apps
#   must have a MinimumOSVersion of 15.0 or later in order to be uploaded to
#   App Store Connect or submitted for distribution.
#
# Ese aviso salía en cada subida. Se adelanta el cambio en vez de esperar a
# que sea un error, y de paso las cuatro apps de la casa quedan en el mismo
# número.
#
# Poner 15 con Flutter 3.35.4 es válido: el motor pide 13 o más. Al revés no:
# subir a Flutter 3.47 con el proyecto en 13 hace que `pod install` falle con
# «required a higher minimum deployment target», que es lo que tumbó el build
# de Mobilink Assist. Este número solo puede subir.
#
# A cambio, un iPad con iOS 13 o 14 ya no puede instalarla.
#
# El fichero va COMMITEADO a propósito. Flutter solo lo genera al compilar en
# un Mac, y aquí no hay ninguno: el workflow hace `cd ios && pod install` en el
# primer paso, y sin Podfile ese paso muere antes de empezar.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Los pods heredan el mínimo del proyecto: sin esto, alguno se queda con
      # el suyo (9.0 en flutter_image_compress) y Xcode avisa en cada build.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
