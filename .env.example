# Render / server
NODE_ENV=production
PUBLIC_APP_URL=https://sea-tarragona.onrender.com
AGENDA_TIME_ZONE=Europe/Madrid

# PostgreSQL / Supabase database used by the Express backend
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase backend admin client
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=avatars
SUPABASE_ROADSIDE_BUCKET=roadside

# Supabase frontend client, required at Vite build time
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# App passwords / roles
ADMIN_TOKEN=
ADMIN_PASSWORD=replace-with-admin-password
SUPERVISOR_PASSWORD=replace-with-supervisor-password
SCREENS_PASSWORD=replace-with-screens-password
TV75_PASSWORD=replace-with-tv75-password
BACKUP_PASSWORD=replace-with-backup-password
ROADSIDE_OPERATOR_CODE=
APP_PASSWORD=

# OpenAI OCR / parsing
OPENAI_API_KEY=replace-with-openai-api-key
# Modelos de IA: se cambian aqui, sin tocar codigo ni desplegar.
# Verificado 30-07-2026: gpt-5.6-luna soporta Responses API, Structured
# Outputs (json_schema estricto) e imagenes.
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_DOCUMENT_MODEL=gpt-5.6-luna
OPENAI_REPORT_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna
# Solo se usa ante errores tecnicos del proveedor (429/5xx/timeout).
OPENAI_FALLBACK_MODEL=gpt-5-mini

# WhatsApp / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+34000000000
TWILIO_WHATSAPP_NUMBER=
TWILIO_CONTENT_SID=
TWILIO_ROADSIDE_CONTENT_SID=
TWILIO_JOB_FINISHED_CONTENT_SID=

# SEA Administración — envíos automáticos de recobros
# Escalada de avisos por WhatsApp (Content Templates aprobadas en Twilio)
TWILIO_RECOBROS_AVISO1_SID=
TWILIO_RECOBROS_AVISO2_SID=
TWILIO_RECOBROS_AVISO3_SID=
TWILIO_RECOBROS_AVISO4_SID=
TWILIO_RECOBROS_RESUMEN_SID=

# Recordatorios de caducidad de tacógrafo
# Plantilla WhatsApp aprobada: {{1}} nombre, {{2}} matrícula, {{3}} fecha caducidad, {{4}} teléfono taller.
# Si se deja vacío se envía texto libre (solo entrega dentro de la ventana de 24h).
TWILIO_CADUCIDAD_CONTENT_SID=
# Número Twilio con capacidad SMS (formato +34...). Sin él, el canal SMS queda en error controlado.
TWILIO_SMS_FROM=
# Teléfono del taller mostrado en los mensajes
CADUCIDAD_TALLER_PHONE=977 21 00 00
# Hora local (Europe/Madrid) a partir de la cual se envían los avisos diarios
CADUCIDAD_NOTIFY_HOUR=08:00
# Hora a partir de la cual se procesan los envíos del día (HH:MM, hora de Madrid)
RECOBROS_NOTIFY_HOUR=08:00

# Email (informes de asistencia y recordatorios de recobro)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Maps: geocodificacion (buscador de ubicacion del mapa operativo:
# localidad, codigo postal, punto kilometrico) y ETAs/rutas por carretera.
GOOGLE_MAPS_API_KEY=

# Stripe / cobros
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Webfleet (posiciones, viajes, odómetro). Cuenta global; por empresa se puede
# sobrescribir en Supabase (tc_webfleet_config).
WEBFLEET_ACCOUNT=
WEBFLEET_USERNAME=
WEBFLEET_PASSWORD=
WEBFLEET_API_KEY=
WEBFLEET_BASE_URL=https://csv.webfleet.com/extern
