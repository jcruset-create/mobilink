# Render / server
NODE_ENV=production
# Dominio propio del servicio (custom domain en Render). El .onrender.com no
# vale aqui: isInternalHost() lo descarta y los enlaces saldrian con el
# dominio canonico. OJO: si se cambia, hay que actualizar tambien la URL del
# webhook en la consola de Twilio, porque la firma se valida contra esta.
PUBLIC_APP_URL=https://sea-tarragona.onrender.com
AGENDA_TIME_ZONE=Europe/Madrid

# PostgreSQL / Supabase database used by the Express backend
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase backend admin client
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=avatars
SUPABASE_ROADSIDE_BUCKET=roadside

# Supabase frontend client, required at Vite build time
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# App passwords / roles
ADMIN_TOKEN=
ADMIN_PASSWORD=replace-with-admin-password
SUPERVISOR_PASSWORD=replace-with-supervisor-password
SCREENS_PASSWORD=replace-with-screens-password
TV75_PASSWORD=replace-with-tv75-password
BACKUP_PASSWORD=replace-with-backup-password
ROADSIDE_OPERATOR_CODE=
APP_PASSWORD=

# OpenAI OCR / parsing
OPENAI_API_KEY=replace-with-openai-api-key
# Modelos de IA: se cambian aqui, sin tocar codigo ni desplegar.
# Verificado 30-07-2026: gpt-5.6-luna soporta Responses API, Structured
# Outputs (json_schema estricto) e imagenes.
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_DOCUMENT_MODEL=gpt-5.6-luna
OPENAI_REPORT_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna
# Solo se usa ante errores tecnicos del proveedor (429/5xx/timeout).
OPENAI_FALLBACK_MODEL=gpt-5-mini

# WhatsApp / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+34000000000
TWILIO_WHATSAPP_NUMBER=
TWILIO_CONTENT_SID=
TWILIO_ROADSIDE_CONTENT_SID=
TWILIO_JOB_FINISHED_CONTENT_SID=

# SEA Administración — envíos automáticos de recobros
# Escalada de avisos por WhatsApp (Content Templates aprobadas en Twilio)
TWILIO_RECOBROS_AVISO1_SID=
TWILIO_RECOBROS_AVISO2_SID=
TWILIO_RECOBROS_AVISO3_SID=
TWILIO_RECOBROS_AVISO4_SID=
TWILIO_RECOBROS_RESUMEN_SID=

# Recordatorios de caducidad de tacógrafo
# Plantilla WhatsApp aprobada: {{1}} nombre, {{2}} matrícula, {{3}} fecha caducidad, {{4}} teléfono taller.
# Si se deja vacío se envía texto libre (solo entrega dentro de la ventana de 24h).
TWILIO_CADUCIDAD_CONTENT_SID=
# Número Twilio con capacidad SMS (formato +34...). Sin él, el canal SMS queda en error controlado.
TWILIO_SMS_FROM=
# Teléfono del taller mostrado en los mensajes
CADUCIDAD_TALLER_PHONE=977 21 00 00
# Hora local (Europe/Madrid) a partir de la cual se envían los avisos diarios
CADUCIDAD_NOTIFY_HOUR=08:00
# Hora a partir de la cual se procesan los envíos del día (HH:MM, hora de Madrid)
RECOBROS_NOTIFY_HOUR=08:00

# Email (informes de asistencia y recordatorios de recobro)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Maps: geocodificacion (buscador de ubicacion del mapa operativo:
# localidad, codigo postal, punto kilometrico) y ETAs/rutas por carretera.
GOOGLE_MAPS_API_KEY=

# Notificaciones push (Firebase Cloud Messaging v1). Las usan todas las APKs
# del ecosistema, incluida Mobilink Assist Lite: sin ellas el operario no se
# entera de una asignacion con la app cerrada y solo le llega al sondear.
# FIREBASE_SERVICE_ACCOUNT es el JSON entero de la cuenta de servicio, en una
# sola linea. FIREBASE_PROJECT_ID solo hace falta si el proyecto no coincide
# con el del JSON.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# Stripe / cobros
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Webfleet (posiciones, viajes, odómetro). Cuenta global; por empresa se puede
# sobrescribir en Supabase (tc_webfleet_config).
WEBFLEET_ACCOUNT=
WEBFLEET_USERNAME=
WEBFLEET_PASSWORD=
WEBFLEET_API_KEY=
WEBFLEET_BASE_URL=https://csv.webfleet.com/extern

# ── Telematics Hub · credenciales por cliente y por cuenta ────
# Los tokens de los proveedores de telematica NO van en la base ni aqui con
# nombre fijo: los resuelve el gestor de secretos por nombre de variable, del
# mas especifico al mas general:
#
#   IH_SECRET__<TENANT>__<CONECTOR>__<CUENTA>__<NOMBRE>   una cuenta concreta
#   IH_SECRET__<TENANT>__<CONECTOR>__<NOMBRE>             todas las del cliente
#   IH_SECRET__<CONECTOR>__<NOMBRE>                       fallback global
#
# <TENANT> es el uuid de tc_empresas y <CUENTA> el account_key de
# integration_connector_configs, los dos en MAYUSCULAS y con lo que no sea
# alfanumerico convertido a '_'. El escalon de la CUENTA hace falta cuando un
# cliente tiene dos cuentas del mismo proveedor con tokens distintos; con una
# sola no hay que ponerlo. Ejemplo:
#
#   IH_SECRET__8F3A_..._B1__MOVERTIS__PLANA_BUSES__TOKEN=...
#   IH_SECRET__8F3A_..._B1__MOVERTIS__PLANA_AUXILIAR__TOKEN=...
#
# Estas variables se ponen en Render, nunca en el repositorio.

# ── TyreControl · informe del CheckPoint por correo ───────────
# Buzón al que se reenvía el informe semanal de Bridgestone. Sin estas tres,
# el vigilante no arranca y el informe se sigue subiendo a mano desde el panel.
# El buzon esta en cdmon, que autentica con usuario y contrasena normales (no
# hay OAuth2 de por medio, a diferencia de Microsoft 365). El host por dominio
# es imap.<dominio>; el usuario es la direccion entera.
# cdmon no tiene contrasenas de aplicacion: la contrasena que va aqui es la del
# buzon. Por eso tiene que ser un buzon DEDICADO al CheckPoint, nunca uno
# personal — esta credencial vive en una variable de entorno.
CHECKPOINT_IMAP_HOST=imap.mobilink.es
CHECKPOINT_IMAP_PORT=993
CHECKPOINT_IMAP_USER=tyrecontrol@mobilink.es
CHECKPOINT_IMAP_PASS=
CHECKPOINT_IMAP_CARPETA=INBOX
CHECKPOINT_IMAP_MIN=15
# A quién avisar cuando una importación traiga avisos o falle. Vacío = solo
# queda registrado en tc_checkpoint_ejecuciones.
CHECKPOINT_AVISO_A=

# ── TyreControl · sincronización desde Mobilink Assist ────────
# Usuario de INTEGRACIÓN de TyreControl. Es un usuario real de Supabase Auth
# con su fila en `tc_usuarios`: los RPC de TC deciden el permiso con
# auth.uid(), y la clave de servicio no es nadie para ellos.
#
# Permisos mínimos: rol `operador`, `acceso_apk = false`, y solo las empresas
# necesarias en `tc_operador_empresas`. NO administrador ni superadmin.
TC_SERVICE_USER_EMAIL=integracion-assist@ejemplo.com
TC_SERVICE_USER_PASSWORD=replace-with-password

# Las TRES llaves de la escritura. Las tres tienen que estar puestas, y
# además el cliente debe tener empresa de TyreControl asignada en su ficha.
#
# TYRE_CONTROL_SYNC_COMPANIES vacío significa NINGUNA empresa: se empieza por
# una concreta —la de pruebas— y se amplía cuando esa funciona.
TYRE_CONTROL_WRITE_ENABLED=false
TYRE_CONTROL_REPAIR_SYNC_ENABLED=false
# La sustitución lleva su propia llave, aparte de la general: encender la
# escritura para que funcionen las reparaciones no puede encender de paso algo
# que mueve dos neumáticos y consume stock del almacén.
TYRE_CONTROL_REPLACEMENT_SYNC_ENABLED=false
TYRE_CONTROL_SYNC_COMPANIES=

# Recepciones (recepción física de mercancía de proveedores). Los PDF —el
# albarán original del proveedor y el recepcionado— van a un bucket privado.
# RECEPCIONES_STORAGE_LOCAL=1 fuerza el disco (server/uploads/recepciones):
# sólo para desarrollo y pruebas, el contenedor de Render es efímero.
RECEPCIONES_DOCUMENTS_BUCKET=recepciones-documentos
# RECEPCIONES_STORAGE_LOCAL=1

# OR Manuales (blocs de ordenes de reparacion en papel). Cada pagina escaneada
# es una OR y va a un bucket PRIVADO: una OR lleva matricula, cliente y lo que
# se hizo en el vehiculo, asi que nunca se sirve por enlace publico.
# OR_MANUALES_STORAGE_LOCAL=1 fuerza el disco (server/uploads/or-manuales):
# solo para desarrollo y pruebas, el contenedor de Render es efimero.
# La lectura del numero de OR en hojas escaneadas SIN texto usa la vision de
# OpenAI (OPENAI_API_KEY, mas arriba). Sin clave, esas hojas quedan en la
# bandeja de documentos pendientes en vez de archivarse mal.
OR_MANUALES_DOCUMENTS_BUCKET=or-manuales-documentos
# OR_MANUALES_STORAGE_LOCAL=1
# ── Recepciones · buzón de los correos del proveedor ─────────
# Buzon del que Recepciones lee los avisos de pedido y de albaran (Soledad).
# Sin estas variables el buzon queda apagado y los correos se importan a mano
# como .eml desde el panel. Una empresa por buzon: el correo dice el proveedor,
# no el tenant.
#
# El buzon esta en cdmon, como el del CheckPoint: host imap.<dominio>, usuario
# la direccion entera, contrasena la del buzon (cdmon no tiene contrasenas de
# aplicacion).
#
# pedidos@comercialsea.com es un buzon DEDICADO a esto: nadie trabaja dentro,
# y por eso su contrasena puede vivir en una variable de entorno. Aun asi el
# modulo no escribe en el: no marca nada como leido ni toca ninguna bandera,
# y lleva su propio avance por UID en rcp_config (ver la cabecera de
# server/recepciones/buzon.ts).
#
# Quien puede entrar lo decide la ficha del proveedor: sin remitentes
# configurados en rcp_proveedores.remitentes_correo el buzon no procesa nada.
# Si los avisos de Soledad llegan aqui REENVIADOS desde otra cuenta, el
# remitente que hay que poner es el de quien reenvia, no el de Soledad.
RECEPCIONES_IMAP_HOST=imap.comercialsea.com
RECEPCIONES_IMAP_PORT=993
RECEPCIONES_IMAP_USER=pedidos@comercialsea.com
RECEPCIONES_IMAP_PASS=
RECEPCIONES_IMAP_CARPETA=INBOX
RECEPCIONES_IMAP_MIN=5
RECEPCIONES_IMAP_EMPRESA_ID=00000000-0000-4000-a000-000000000001

# --- Recepciones: aviso por WhatsApp al recibir la mercancia -----------------
# Al cerrar una recepcion OK se avisa a quien la espera, si el albaran traia su
# movil en las observaciones. Sale por las credenciales de Twilio de arriba
# (TWILIO_*), no por unas propias.
#
# WhatsApp no deja escribir primero sin una plantilla aprobada, que en Twilio es
# un Content SID. El texto que hay que dar de alta es:
#
#   {{1}}: ha llegado tu material a {{2}}.
#   {{3}}
#   — COMERCIAL SEA, S.A.
#
# donde {{1}} es el saludo («Hola JORGE PLANA»), {{2}} el centro y {{3}} el
# material con sus unidades («245/70 R17.5 HANKOOK AH35 136M (2 uds.)»). El
# texto exacto, con la firma de la empresa ya puesta, se puede copiar de la
# pantalla «Avisos por WhatsApp» del modulo. Sin SID se manda texto plano: vale
# en el sandbox y dentro de las 24 h de una conversacion abierta, y fuera lo
# rechaza Twilio.
#
# El interruptor NO esta aqui: se enciende por empresa en la pantalla «Avisos
# por WhatsApp» del modulo, y de fabrica esta apagado.
RECEPCIONES_WHATSAPP_CONTENT_SID=
