# Variables del entorno de PRUEBAS. Copiar, rellenar y NO subir al repositorio.
#
# Esto NO es una copia de las 34 variables del servicio de producción. Copiar
# aquellas metería en pruebas las credenciales de pagos, mensajería, buzones de
# correo y el ERP, y la prueba de la importación histórica no usa ninguna.
#
# Las que están aquí son las que la prueba necesita de verdad, más los
# interruptores que apagan lo que puede salir al mundo.

# ── Imprescindibles ────────────────────────────────────────────────────────
# La base de PRUEBAS. Cuidado: arrancar el servidor ejecuta DDL sobre esta
# base (prepararEsquema en server/index.ts). Antes de arrancar, comprobar el
# destino: psql "$DATABASE_URL" -At -c "select current_setting('mobilink.entorno', true)"
DATABASE_URL=
PGSSLMODE=require

# Proyecto Supabase de PRUEBAS. Estas dos son de arranque: sin ellas el
# servidor no levanta (server/supabase.ts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Las del panel. Se COMPILAN dentro del bundle: si aquí va el proyecto de
# producción, el panel de pruebas hablará con producción.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

NODE_ENV=production
PORT=10000
TZ=Europe/Madrid
PUBLIC_APP_URL=

# ── Apagado explícito de las escrituras de TyreControl hacia fuera ────────
TYRE_CONTROL_WRITE_ENABLED=false
TYRE_CONTROL_REPAIR_SYNC_ENABLED=false
TYRE_CONTROL_REPLACEMENT_SYNC_ENABLED=false
# Vacío significa NINGUNA empresa, no todas.
TYRE_CONTROL_SYNC_COMPANIES=

# ── Ficheros al disco del contenedor, no a Storage ────────────────────────
CASH_STORAGE_LOCAL=1
RECEPCIONES_STORAGE_LOCAL=1
OR_MANUALES_STORAGE_LOCAL=1
TACOGRAFOS_STORAGE_LOCAL=1
THEREFORE_STORAGE_LOCAL=1
SELF_STORAGE_STORAGE_LOCAL=1

# ── Lo que NO se define, y no es un olvido ────────────────────────────────
# Sin credencial, cada integración se queda fuera de servicio. Eso es lo que
# se busca: lo que no está configurado no puede cobrar, ni enviar un mensaje,
# ni vaciar un buzón, ni escribir en el ERP. NO pongas aquí los valores de
# producción «para que no falle»: que falle es el comportamiento correcto.
#
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SELF_STORAGE_STRIPE_*
#   TWILIO_*  (WhatsApp y SMS)
#   SMTP_*    (correo saliente)
#   CHECKPOINT_IMAP_*, RECEPCIONES_IMAP_*, THEREFORE_IMAP_*  (buzones)
#   OPENAI_*  (sin esto, la lectura de partes responde 503 y nada más)
#   WEBFLEET_*, MOVERTIS_*  (telemetría)
#   BC_*, IH_SECRET__*      (Business Central)
#   FIREBASE_*, GOOGLE_MAPS_API_KEY
#
# Para la prueba, el PDF se pide por GET /api/tyrecontrol/parte/:id/pdf, que
# devuelve el PDF en la respuesta y no escribe en Storage. El endpoint que sí
# escribe es /pdf/enlace, y no hace falta.
#
# Secretos y contraseñas de acceso (ADMIN_TOKEN, ADMIN_PASSWORD,
# SUPERVISOR_PASSWORD, APP_PASSWORD, LICENSE_SECRET…): valores NUEVOS de
# pruebas. Nunca los de producción.
#
# COMPROBADO: con esta lista exacta el servidor arranca y el endpoint del PDF
# responde (scripts/staging/05-probar-arranque.sh). STRIPE_SECRET_KEY tumbaba
# el arranque hasta que el cliente de Stripe pasó a crearse solo cuando hay
# clave; ahora sin ella el servidor levanta y los pagos responden 503.
